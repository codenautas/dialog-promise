{
  "name": "dialog-promise",
  "description": "Dialog that returns promises",
  "version": "0.10.7",
  "author": "Codenautas <codenautas@googlegroups.com>",
  "repository": "codenautas/dialog-promise",
  "license": "MIT",
  "main": "lib/dialog-promise.js",
  "files": [
    "lib"
  ],
  "overrides": {
    "diff": ">=8.0.2",
    "serialize-javascript": ">=7.0.0",
    "uuid": ">=14.0.0",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^4.1.0"
    }
  },
  "dependencies": {
    "best-globals": "^2.2.3"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "mocha": "^12.0.3",
    "nyc": "^18.0.0",
    "discrepances": "^0.2.14",
    "qa-control": "^0.12.2",
    "require-bro": "^0.4.1",
    "server4test": "^2.0.0-rc.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">= 16"
  },
  "scripts": {
    "build-test": "tsc -p test && nyc instrument --delete lib local-instrumented/lib",
    "test": "npm run test-navigator",
    "test-ci": "npm run test-navigator && nyc report --reporter=text --reporter=html --reporter=lcov",
    "test-navigator": "npm run build-test && server4test --run-browser chrome,firefox",
    "test-navigator-inf": "npm run build-test && server4test"
  },
  "qa-control": {
    "profile": "minimum",
    "coverage": 90,
    "run-in": "client",
    "type": "lib",
    "gha": "all"
  }
}
